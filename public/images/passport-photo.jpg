<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#0D1422"/>
  <rect x="50" y="50" width="700" height="500" rx="16" fill="#111827" stroke="#1E293B" stroke-width="4"/>
  <!-- Passport Photo Grid -->
  <g fill="#2563EB" stroke="#FFFFFF" stroke-width="3">
    <rect x="180" y="120" width="120" height="150" rx="6"/>
    <rect x="340" y="120" width="120" height="150" rx="6"/>
    <rect x="500" y="120" width="120" height="150" rx="6"/>
    <rect x="180" y="300" width="120" height="150" rx="6"/>
    <rect x="340" y="300" width="120" height="150" rx="6"/>
    <rect x="500" y="300" width="120" height="150" rx="6"/>
  </g>
  <text x="400" y="510" font-family="sans-serif" font-weight="700" font-size="24" fill="#F8FAFC" text-anchor="middle">Instant Passport Size Photos &amp; Document Photography</text>
</svg>
